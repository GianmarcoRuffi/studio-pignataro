# Resend API Configuration
# Ottieni la tua API key da: https://resend.com/api-keys
RESEND_API_KEY=re_123456789_your_api_key_here

# Email mittente (obbligatoria: deve essere verificata su Resend)
# Per test locale puoi usare: onboarding@resend.dev
# In produzione usa: noreply@archpignataro.it (dopo aver verificato il dominio)
EMAIL_FROM=onboarding@resend.dev

# Email destinatario (obbligatoria: dove arrivano i messaggi dal form)
# Preview/Staging: usa un indirizzo tecnico o personale separato
# Production: info@archpignataro.it
EMAIL_TO=info@archpignataro.it
